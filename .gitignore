# ==========================================
# ArenaSync Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files & Secrets (keep examples & tracked production env)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
Backend/.env
Frontend/.env
!.env.example
!*.env.example
!Backend/.env.example
!Frontend/.env.example
!Frontend/.env.production

# Build & Bundler outputs
dist/
dist-ssr/
build/
Frontend/dist/
Frontend/build/
*.local
.cache/
.vite/
Frontend/.vite/

# Runtime data & Uploads
Backend/uploads/
uploads/
temp/
tmp/

# Logs
logs/
*.log

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Testing & Coverage
coverage/
.nyc_output/

# Deployment & CI
.vercel/
.turbo/
